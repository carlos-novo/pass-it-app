{
  "name": "pass-it-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo del juego Party Game multijugador Pass It",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "yarn workspace @pass-it/mobile start",
    "backend": "yarn workspace @pass-it/backend start:dev",
    "lint": "yarn workspaces run lint",
    "format": "yarn workspaces run format"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "react-native-worklets": "^0.5.2"
  },
  "overrides": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
